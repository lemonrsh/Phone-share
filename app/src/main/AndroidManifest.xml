<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- "<device> is connected to this phone" while another device mirrors this one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Cloudflare sharing permissions are added by src/cloudflared/AndroidManifest.xml. -->
    <!-- "Phone Share is running" notifications (floating window and full-screen sessions). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <!-- Rotation and resizing are handled in code so that the mirroring
             Surface and the network session survive them. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share links: phoneshare://connect?host=…&pin=… opened by the link's web page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="connect"
                    android:scheme="phoneshare" />
            </intent-filter>
            <!-- The https share link itself (Android 11 and older may offer to open it here;
                 newer Android opens it in the browser, whose page then opens the app). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="*.trycloudflare.com"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/logs_title" />

        <service
            android:name=".FloatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Told by the scrcpy server on this phone (running as the shell user) that another
             device connected or left. DUMP: only the shell/system can send it, not other apps. -->
        <receiver
            android:name=".IncomingSessionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.lemonrsh.phoneshare.action.SESSION_STARTED" />
                <action android:name="com.lemonrsh.phoneshare.action.SESSION_ENDED" />
            </intent-filter>
        </receiver>

        <!-- Disconnect button of the "connected to this phone" notification. -->
        <receiver
            android:name=".IncomingDisconnectReceiver"
            android:exported="false" />

        <!-- Keeps the "connected to this phone" notification while a session runs. -->
        <service
            android:name=".IncomingSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user that another device is mirroring and controlling this phone, with a Disconnect button" />
        </service>

        <!-- Stop button of the "Phone Share is running" notification. -->
        <receiver
            android:name=".StopReceiver"
            android:exported="false" />
    </application>
</manifest>
